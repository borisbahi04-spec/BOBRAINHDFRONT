@echo off
REM Redemarre proprement le front Helpdesk (port 3000)
cd /d "%~dp0"
echo Arret des serveurs sur les ports 3000 et 3001...
for %%P in (3000 3001) do for /f "tokens=5" %%A in ('netstat -ano ^| findstr ":%%P " ^| findstr LISTENING') do taskkill /PID %%A /F >nul 2>&1
echo Suppression du cache .next...
if exist .next rmdir /s /q .next
echo Installation des dependances (Tailwind)...
call npm install
echo Demarrage sur http://localhost:3000 ...
call npm run dev
